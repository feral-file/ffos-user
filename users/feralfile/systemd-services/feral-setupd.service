[Unit]
Description=Feral File Setup Service
After=system-ready.target feral-player.service feral-controld.service
StartLimitBurst=5
StartLimitIntervalSec=600

[Service]
Type=simple
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus"
Environment="XDG_RUNTIME_DIR=/run/user/1000"
ExecStart=/usr/bin/feral-setupd
Restart=always
RestartSec=5s
TimeoutStopSec=5s
StandardOutput=append:/home/feralfile/.logs/setupd.log
StandardError=append:/home/feralfile/.logs/setupd.log

# Activation is the explicit start in .start-services.sh — units in this dir are
# bind-mounted, never `systemctl --user enable`d, so [Install] alone starts
# nothing. Kept for consistency with the other units here.
[Install]
WantedBy=default.target
