# Separate public engine integration. This host has no libcef dependency.
pkg_check_modules(CURL REQUIRED IMPORTED_TARGET libcurl)
set(FF_PRESENTATION_PREFIX "${CMAKE_CURRENT_SOURCE_DIR}/build-presentation/prefix" CACHE PATH "Pinned private compositor libraries")
if(NOT EXISTS "${FF_PRESENTATION_PREFIX}/lib/pkgconfig/wlroots-0.20.pc")
  message(FATAL_ERROR "Build the pinned private compositor with tools/build-presentation.sh")
endif()
set(ENV{PKG_CONFIG_PATH} "${FF_PRESENTATION_PREFIX}/lib/pkgconfig:${FF_PRESENTATION_PREFIX}/share/pkgconfig:$ENV{PKG_CONFIG_PATH}")
unset(__pkg_config_checked_WLR CACHE)
pkg_check_modules(WLR REQUIRED IMPORTED_TARGET wlroots-0.20 wayland-server xkbcommon)
add_library(ff_browser_surface src/browser_surface.c)
target_include_directories(ff_browser_surface PUBLIC include)
target_link_libraries(ff_browser_surface PUBLIC PkgConfig::WLR)
target_compile_options(ff_browser_surface PRIVATE -Wall -Wextra -Werror)
add_executable(artwork-cache-tests tests/artwork_cache_test.cpp)
target_link_libraries(artwork-cache-tests PRIVATE ff_artwork_cache)
target_link_options(artwork-cache-tests PRIVATE -Wl,--wrap=statvfs)
add_test(NAME artwork-cache COMMAND artwork-cache-tests)
add_executable(gateway-route-tests src/gateway.cpp tests/gateway_route_test.cpp)
add_dependencies(gateway-route-tests artwork-egress)
target_link_libraries(gateway-route-tests PRIVATE ff_core PkgConfig::GLIB "${CMAKE_CURRENT_BINARY_DIR}/libff_network.so")
set_target_properties(gateway-route-tests PROPERTIES BUILD_RPATH "$ORIGIN" INSTALL_RPATH "$ORIGIN")
add_test(NAME gateway-route COMMAND gateway-route-tests)
add_library(ff_host SHARED src/gateway.cpp src/public_main.cpp src/public_browser.cpp src/presentation.cpp src/media_client.cpp)
add_dependencies(ff_host artwork-egress)
target_link_libraries(ff_host PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/libff_network.so")
target_include_directories(ff_host PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
target_link_libraries(ff_host PRIVATE ff_artwork_cache ff_presentation_feedback ff_core ff_device_ui ff_media_ipc ff_browser_surface ff_cache_client PkgConfig::NATIVE PkgConfig::CURL dl)
add_executable(feral-display src/player_main.cpp src/sandbox.cpp)
target_include_directories(feral-display PRIVATE vendor)
target_link_libraries(feral-display PRIVATE dl)
install(TARGETS feral-display RUNTIME DESTINATION lib/feral-display)
install(TARGETS ff_host LIBRARY DESTINATION lib/feral-display)

install(DIRECTORY assets/fonts/ DESTINATION share/feral-display/fonts)
install(DIRECTORY renderers/ DESTINATION share/feral-display/renderers)
install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/vendor/model-viewer-LICENSE" DESTINATION share/licenses/feral-display RENAME model-viewer.txt)
install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/vendor/draco-LICENSE" "${CMAKE_CURRENT_SOURCE_DIR}/vendor/basis-LICENSE" DESTINATION share/licenses/feral-display)
install(FILES dependencies.json DESTINATION share/feral-display)
install(FILES third_party/color-name/LICENSE DESTINATION share/licenses/feral-display RENAME color-name.txt)
install(FILES protocol/schema.json protocol/README.md DESTINATION share/feral-display/protocol)


set(FF_PRESENTATION_PREFIX "${CMAKE_CURRENT_SOURCE_DIR}/build-presentation/prefix" CACHE PATH "Pinned private compositor libraries")
set_target_properties(ff_host PROPERTIES INSTALL_RPATH "$ORIGIN;$ORIGIN/presentation")
install(DIRECTORY "${FF_PRESENTATION_PREFIX}/lib/" DESTINATION lib/feral-display/presentation FILES_MATCHING PATTERN "libwlroots-0.20.so*")
install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/vendor/wlroots-0.20.0/LICENSE" DESTINATION share/licenses/feral-display RENAME wlroots.txt)
