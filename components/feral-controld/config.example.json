{
  "cdp": {
    "endpoint": "localhost"
  },
  "relayer": {
    "endpoint": "wss://example.com/ws",
    "apiKey": "YOUR_RELAYER_API_KEY"
  },
  "mintPairing": {
    "enabled": false,
    "brokerBaseURL": "https://mint-pairing.example.com",
    "idleTTLSeconds": 300,
    "pollIntervalMillis": 500,
    "approvalTimeoutSeconds": 300
  },
  "sentry": {
    "dsn": "https://YOUR_SENTRY_DSN@o0.ingest.sentry.io/0",
    "debug": "false",
    "sample_rate": "1.0",
    "environment": "production",
    "release": "feral-controld@1.0.0",
    "repository": "organization/repository-name"
  },
  "commandStorm": {
    "disabled": false,
    "maxConcurrent": 0
  },
  "offlineCache": {
    "enabled": false,
    "resourceGate": {
      "disabled": false,
      "softwareMaxMemoryPercent": 80,
      "softwareMaxCpuTempC": 75,
      "mediaMaxMemoryPercent": 90,
      "mediaMaxCpuTempC": 85,
      "memorySafetyCeilingPercent": 90,
      "metricsStaleAfterSeconds": 15,
      "maxDeferSeconds": 3600
    },
    "headlessLimits": {
      "disabled": false,
      "cpuQuotaPercent": 300,
      "allowedCpus": "0-3",
      "memoryMaxBytes": 2147483648
    }
  },
  "enableHub": true
}
