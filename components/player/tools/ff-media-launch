#!/bin/sh
set -eu
# No home, player state, controld socket, D-Bus session, user scripts or writable
# host filesystem are visible to the decoder. FD 3 is its only control channel.
media_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
media_runtime=${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}
media_display=${WAYLAND_DISPLAY:-wayland-0}
case "$media_display" in */*|.*) echo 'Expected a relative Wayland socket name' >&2; exit 1;; esac
set -- /usr/bin/bwrap --die-with-parent --new-session --unshare-all --share-net --clearenv \
  --ro-bind /usr /usr --symlink usr/lib /lib --symlink usr/lib /lib64 \
  --proc /proc --dev /dev --dev-bind /dev/dri /dev/dri --tmpfs /tmp \
  --ro-bind /sys/devices /sys/devices --ro-bind /sys/dev/char /sys/dev/char --ro-bind /sys/class/drm /sys/class/drm \
  --ro-bind /etc/ssl /etc/ssl --ro-bind /etc/fonts /etc/fonts \
  --ro-bind /etc/resolv.conf /etc/resolv.conf --ro-bind /etc/hosts /etc/hosts \
  --ro-bind "$media_dir" /app --dir "$media_runtime" \
  --ro-bind "$media_runtime/$media_display" "$media_runtime/$media_display" \
  --setenv XDG_RUNTIME_DIR "$media_runtime" --setenv WAYLAND_DISPLAY "$media_display" \
  --setenv SDL_VIDEODRIVER wayland --setenv LD_LIBRARY_PATH /app \
  --setenv LANG C.UTF-8
if [ -S "$media_runtime/pulse/native" ]; then
  set -- "$@" --ro-bind "$media_runtime/pulse/native" "$media_runtime/pulse/native" \
    --setenv PULSE_SERVER "unix:$media_runtime/pulse/native"
fi
exec "$@" /app/ff-media-worker
