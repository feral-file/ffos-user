# Separate public engine integration. This host has no libcef dependency.
pkg_check_modules(CURL REQUIRED IMPORTED_TARGET libcurl)
set(FF_PRESENTATION_PREFIX "${CMAKE_CURRENT_SOURCE_DIR}/build-presentation/prefix" CACHE PATH "Pinned private compositor libraries")
if(NOT EXISTS "${FF_PRESENTATION_PREFIX}/lib/pkgconfig/wlroots-0.20.pc")
  message(FATAL_ERROR "Build the pinned private compositor with tools/build-presentation.sh")
endif()
set(ENV{PKG_CONFIG_PATH} "${FF_PRESENTATION_PREFIX}/lib/pkgconfig:${FF_PRESENTATION_PREFIX}/share/pkgconfig:$ENV{PKG_CONFIG_PATH}")
unset(__pkg_config_checked_WLR CACHE)
pkg_check_modules(WLR REQUIRED IMPORTED_TARGET wlroots-0.20 wayland-server xkbcommon)
add_library(ff_browser_surface src/browser_surface.c)
target_include_directories(ff_browser_surface PUBLIC include)
target_link_libraries(ff_browser_surface PUBLIC PkgConfig::WLR)
target_compile_options(ff_browser_surface PRIVATE -Wall -Wextra -Werror)
add_executable(ff-player-native src/public_main.cpp src/public_browser.cpp src/profile_gc.cpp src/presentation.cpp src/media_client.cpp)
target_include_directories(ff-player-native PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
target_link_libraries(ff-player-native PRIVATE ff_presentation_feedback ff_core ff_device_ui ff_media_ipc ff_browser_surface ff_cache_client PkgConfig::NATIVE PkgConfig::CURL dl)
install(TARGETS ff-player-native RUNTIME DESTINATION lib/ff-player-native)
install(PROGRAMS tools/ff-browser-launch DESTINATION lib/ff-player-native)

option(FF_PACKAGE_CEF_VIEWS "Package the FF1 CEF Views worker" OFF)
if(FF_PACKAGE_CEF_VIEWS AND NOT FF_WITH_CEF)
  message(FATAL_ERROR "The Views engine requires FF_WITH_CEF")
endif()
if(NOT FF_PACKAGE_CEF_VIEWS)
  execute_process(COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tools/prepare-engine.py COMMAND_ERROR_IS_FATAL ANY)
  install(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/vendor/chrome-linux64/" DESTINATION lib/ff-player-native/engine USE_SOURCE_PERMISSIONS)
  install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/vendor/chrome-linux64/ABOUT" DESTINATION share/licenses/ff-player-native RENAME public-engine-ABOUT.txt)
endif()
install(DIRECTORY assets/fonts/ DESTINATION share/ff-player-native/fonts)
install(DIRECTORY renderers/ DESTINATION share/ff-player-native/renderers)
install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/vendor/model-viewer-LICENSE" DESTINATION share/licenses/ff-player-native RENAME model-viewer.txt)
install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/vendor/draco-LICENSE" "${CMAKE_CURRENT_SOURCE_DIR}/vendor/basis-LICENSE" DESTINATION share/licenses/ff-player-native)
install(FILES dependencies.json DESTINATION share/ff-player-native)
install(FILES third_party/color-name/LICENSE DESTINATION share/licenses/ff-player-native RENAME color-name.txt)
install(FILES protocol/schema.json protocol/README.md DESTINATION share/ff-player-native/protocol)
install(PROGRAMS tools/migrate-legacy.py tools/legacy-export.mjs tools/playerctl.py DESTINATION share/ff-player-native/tools)
install(FILES tools/diagnostic-cdp.mjs DESTINATION share/ff-player-native/tools)


set(FF_PRESENTATION_PREFIX "${CMAKE_CURRENT_SOURCE_DIR}/build-presentation/prefix" CACHE PATH "Pinned private compositor libraries")
set_target_properties(ff-player-native PROPERTIES INSTALL_RPATH "$ORIGIN/presentation")
install(DIRECTORY "${FF_PRESENTATION_PREFIX}/lib/" DESTINATION lib/ff-player-native/presentation FILES_MATCHING PATTERN "libwlroots-0.20.so*")
install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/vendor/wlroots-0.20.0/LICENSE" DESTINATION share/licenses/ff-player-native RENAME wlroots.txt)
