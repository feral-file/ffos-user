set(CEF_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/vendor/cef" CACHE PATH "Pinned unpacked CEF distribution")
list(APPEND CMAKE_MODULE_PATH "${CEF_ROOT}/cmake")
set(PROJECT_ARCH "x86_64")
find_package(CEF REQUIRED)
add_subdirectory("${CEF_LIBCEF_DLL_WRAPPER_PATH}" "cef-wrapper")
if(NOT FF_PACKAGE_CEF_VIEWS)
  add_executable(ff-player-cef-rollback src/cef_main.cpp src/cef_client.cpp src/presentation.cpp src/renderer_app.cpp src/media_client.cpp)
  target_include_directories(ff-player-cef-rollback PRIVATE "${CEF_ROOT}" "${CMAKE_CURRENT_BINARY_DIR}")
  target_link_libraries(ff-player-cef-rollback PRIVATE ff_presentation_feedback ff_core ff_device_ui ff_media_ipc ff_cache_client libcef_dll_wrapper "${CEF_ROOT}/Release/libcef.so" PkgConfig::NATIVE dl)
  target_compile_definitions(ff-player-cef-rollback PRIVATE FF_RENDERER_DIR="${CMAKE_CURRENT_SOURCE_DIR}/renderers")
  set_target_properties(ff-player-cef-rollback PROPERTIES BUILD_RPATH "${CEF_ROOT}/Release" INSTALL_RPATH "$ORIGIN")
  install(TARGETS ff-player-cef-rollback RUNTIME DESTINATION lib/ff-player-native)
endif()
install(DIRECTORY "${CEF_ROOT}/Release/" DESTINATION lib/ff-player-native USE_SOURCE_PERMISSIONS)
install(DIRECTORY "${CEF_ROOT}/Resources/" DESTINATION lib/ff-player-native)
install(DIRECTORY assets/fonts/ DESTINATION share/ff-player-native/fonts)
install(DIRECTORY renderers/ DESTINATION share/ff-player-native/renderers)
install(FILES "${CEF_ROOT}/LICENSE.txt" DESTINATION share/licenses/ff-player-native RENAME CEF.txt)
install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/vendor/model-viewer-LICENSE" DESTINATION share/licenses/ff-player-native RENAME model-viewer.txt)
install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/vendor/draco-LICENSE" "${CMAKE_CURRENT_SOURCE_DIR}/vendor/basis-LICENSE" DESTINATION share/licenses/ff-player-native)
install(FILES dependencies.json DESTINATION share/ff-player-native)
install(FILES third_party/color-name/LICENSE DESTINATION share/licenses/ff-player-native RENAME color-name.txt)
install(FILES protocol/schema.json protocol/README.md DESTINATION share/ff-player-native/protocol)
install(PROGRAMS tools/migrate-legacy.py tools/legacy-export.mjs tools/playerctl.py DESTINATION share/ff-player-native/tools)
install(FILES tools/diagnostic-cdp.mjs DESTINATION share/ff-player-native/tools)

if(FF_PACKAGE_CEF_VIEWS)
  set(views_target ff-cef-views-engine)
else()
  set(views_target cef-views-probe)
endif()
add_executable(${views_target} src/cef_views_worker.cpp)
target_include_directories(${views_target} PRIVATE "${CEF_ROOT}")
target_link_libraries(${views_target} PRIVATE libcef_dll_wrapper "${CEF_ROOT}/Release/libcef.so")
set_target_properties(${views_target} PROPERTIES BUILD_RPATH "${CEF_ROOT}/Release" INSTALL_RPATH "$ORIGIN")
if(FF_PACKAGE_CEF_VIEWS)
  install(TARGETS ${views_target} RUNTIME DESTINATION lib/ff-player-native)
else()
  target_compile_definitions(${views_target} PRIVATE FF_VIEWS_BENCHMARK)
  install(TARGETS ${views_target} RUNTIME DESTINATION lib/ff-player-native COMPONENT diagnostic-probes EXCLUDE_FROM_ALL)
endif()
