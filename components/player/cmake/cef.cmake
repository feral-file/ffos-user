set(CEF_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/vendor/cef" CACHE PATH "Pinned unpacked CEF distribution")
list(APPEND CMAKE_MODULE_PATH "${CEF_ROOT}/cmake")
set(PROJECT_ARCH "x86_64")
find_package(CEF REQUIRED)
add_subdirectory("${CEF_LIBCEF_DLL_WRAPPER_PATH}" "cef-wrapper")
install(DIRECTORY "${CEF_ROOT}/Release/" DESTINATION lib/ff-player-native USE_SOURCE_PERMISSIONS)
install(DIRECTORY "${CEF_ROOT}/Resources/" DESTINATION lib/ff-player-native)
install(DIRECTORY assets/fonts/ DESTINATION share/ff-player-native/fonts)
install(DIRECTORY renderers/ DESTINATION share/ff-player-native/renderers)
install(FILES "${CEF_ROOT}/LICENSE.txt" DESTINATION share/licenses/ff-player-native RENAME CEF.txt)
install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/vendor/model-viewer-LICENSE" DESTINATION share/licenses/ff-player-native RENAME model-viewer.txt)
install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/vendor/draco-LICENSE" "${CMAKE_CURRENT_SOURCE_DIR}/vendor/basis-LICENSE" DESTINATION share/licenses/ff-player-native)
install(FILES dependencies.json DESTINATION share/ff-player-native)
install(FILES third_party/color-name/LICENSE DESTINATION share/licenses/ff-player-native RENAME color-name.txt)
install(FILES protocol/schema.json protocol/README.md DESTINATION share/ff-player-native/protocol)

add_library(ff_browser SHARED src/cef_views_worker.cpp)
# libcef_dll_wrapper is built without RTTI. Resolve every role symbol at
# link time so a successful package can actually enter the browser role.
target_compile_options(ff_browser PRIVATE -fno-rtti)
target_link_options(ff_browser PRIVATE -Wl,-z,defs)
target_include_directories(ff_browser PRIVATE "${CEF_ROOT}" vendor)
target_link_libraries(ff_browser PRIVATE PkgConfig::GLIB)
target_link_libraries(ff_browser PRIVATE libcef_dll_wrapper "${CEF_ROOT}/Release/libcef.so")
set_target_properties(ff_browser PROPERTIES BUILD_RPATH "${CEF_ROOT}/Release" INSTALL_RPATH "$ORIGIN")
install(TARGETS ff_browser LIBRARY DESTINATION lib/ff-player-native)
