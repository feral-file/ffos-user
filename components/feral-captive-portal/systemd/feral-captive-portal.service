[Unit]
Description=FF1 captive portal Wi-Fi provisioning (standalone)
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
TimeoutStartSec=60s
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="CAPTIVE_PORTAL_INSTALL_ROOT=/opt/feral/captive-portal"
EnvironmentFile=-/home/feralfile/.config/feral-captive-portal.env
ExecStart=/opt/feral/captive-portal/scripts/feral-captive-portal.sh
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/feralfile/.logs/feral-captive-portal.log
StandardError=append:/home/feralfile/.logs/feral-captive-portal.log

[Install]
# Manual start only. Boot cleanup unit restores normal Wi-Fi after reboot.
# Use scripts/start-captive-portal.sh over SSH to enter provisioning mode.
WantedBy=default.target
